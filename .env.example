# ---- Firebase web app config (Firebase console > Project settings > Your apps) ----
# These are safe to expose client-side; security comes from Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Google OAuth Client ID (GCP console > Credentials > OAuth 2.0 Client IDs, Web application) ----
# Used for Google Calendar sync. Authorized JavaScript origins must include the
# exact Netlify URL (https://..., no trailing slash) and http://localhost:5173 for dev.
VITE_GOOGLE_CLIENT_ID=

# ---- Spoonacular (server-side only — set in Netlify env vars, never in client code) ----
SPOONACULAR_API_KEY=

# ---- Walmart affiliate API (optional, server-side only — Netlify env vars) ----
# Enables in-app product search on the grocery list. Without it, items are
# matched by pasting walmart.com links. From walmart.io: consumer id, the key
# version shown with your uploaded public key, and the matching private key (PEM).
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY=
WALMART_PUBLISHER_ID=
